<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/bg" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:gravity="center_vertical" android:padding="12dp" android:background="@color/panel" android:layout_width="match_parent" android:layout_height="64dp">
<LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"><TextView android:id="@+id/name" android:text="Qarşı tərəf" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/status" android:text="..." android:textColor="@color/muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<Button android:id="@+id/callBtn" android:text="☎" android:layout_width="54dp" android:layout_height="48dp"/><Button android:id="@+id/videoBtn" android:text="▣" android:layout_width="54dp" android:layout_height="48dp"/><Button android:id="@+id/settingsBtn" android:text="⋮" android:layout_width="54dp" android:layout_height="48dp"/>
</LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:padding="10dp" android:clipToPadding="false" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp"/>
<LinearLayout android:padding="8dp" android:gravity="center_vertical" android:background="@color/panel" android:layout_width="match_parent" android:layout_height="wrap_content"><EditText android:id="@+id/message" android:hint="Mesaj yaz..." android:textColor="@color/text" android:textColorHint="@color/muted" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/sendBtn" android:text="➤" android:layout_width="64dp" android:layout_height="52dp"/></LinearLayout>
</LinearLayout>
